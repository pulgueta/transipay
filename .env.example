# Copy this file to .env and replace the placeholder values.

# PostgreSQL 18 (see compose.yaml).
# The app connects as transipay_web. This login role is a member of transipay_app and does not own the tables.
DATABASE_URL=postgres://transipay_web:transipay_web@localhost:5432/transipay
# drizzle-kit runs the migrations as the table owner. The app does not use this value.
DATABASE_OWNER_URL=postgres://transipay:transipay@localhost:5432/transipay

# better-auth. Generate the secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
BETTER_AUTH_URL=http://localhost:3000

# Wompi payments. Set WOMPI_SANDBOX=false only in production.
WOMPI_SANDBOX=true
WOMPI_PUBLIC_KEY=pub_test_xxxxxxxxxxxxxxxx
WOMPI_PRIVATE_KEY=prv_test_xxxxxxxxxxxxxxxx
WOMPI_INTEGRITY_KEY=test_integrity_xxxxxxxxxxxxxxxx
WOMPI_EVENTS_KEY=test_events_xxxxxxxxxxxxxxxx

# Wompi payouts (dispersions).
WOMPI_PAYOUTS_API_KEY=xxxxxxxxxxxxxxxx
WOMPI_PAYOUTS_USER_PRINCIPAL_ID=xxxxxxxxxxxxxxxx
WOMPI_PAYOUTS_EVENTS_KEY=xxxxxxxxxxxxxxxx

# Public values. Vite sends VITE_* variables to the browser. Do not put secrets here.
VITE_WOMPI_PUBLIC_KEY=pub_test_xxxxxxxxxxxxxxxx
